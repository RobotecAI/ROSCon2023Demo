<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_palletization</name>
  <version>0.0.0</version>
  <description>Palletization with Universal Robots arms using MoveIt Task Constructor, used in the ROSCon 2023 demo</description>
  <maintainer email="kacper.lewandowski@robotec.ai">Kacper Lewandowski</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/RobotecAI/ROSCon2023Demo</url>
  <url type="bugtracker">https://github.com/RobotecAI/ROSCon2023Demo/issues</url>

  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>
  
  <depend>rclcpp</depend>
  <depend>control_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>vision_msgs</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
