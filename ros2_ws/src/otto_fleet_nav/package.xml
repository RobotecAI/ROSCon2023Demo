<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>otto_fleet_nav</name>
  <version>1.0.0</version>
  <description>Nav2 bringup and robot spawning for the OTTO robot fleet in the ROSCon 2023 demo</description>
  <maintainer email="piotr.jaroszek@robotec.ai">Piotr Jaroszek</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/RobotecAI/ROSCon2023Demo</url>
  <url type="bugtracker">https://github.com/RobotecAI/ROSCon2023Demo/issues</url>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
