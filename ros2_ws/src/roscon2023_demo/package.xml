<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roscon2023_demo</name>
  <version>0.0.0</version>
  <description>Launch files, configuration and scripts to run the ROSCon 2023 demo (robotized fulfillment center)</description>
  <maintainer email="artur.kamieniecki@robotec.ai">Artur Kamieniecki</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <url type="repository">https://github.com/RobotecAI/ROSCon2023Demo</url>
  <url type="bugtracker">https://github.com/RobotecAI/ROSCon2023Demo/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>otto_deliberation</depend>
  <depend>blind_path_follower</depend>
  <depend>otto_fleet_nav</depend>
  <depend>global_path_lock</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
